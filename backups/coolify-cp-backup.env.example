# Example env for backups/coolify-cp-backup.sh — COPY, fill in, NEVER commit.
#
#   sudo cp backups/coolify-cp-backup.env.example /etc/coolify-cp-backup.env
#   sudo chmod 600 /etc/coolify-cp-backup.env
#   sudo nano /etc/coolify-cp-backup.env   # real values only on the CP host
#
# Secrets live in the private Drive doc "Contabo Coolify VPS — credentials
# 2026-10-22" and on operator hosts under ~/tmp/secrets/ (never in git).
# The GPG passphrase lives in /etc/coolify-cp-backup.pass (600) — a copy of
# ~/tmp/secrets/coolify-cp-backup.pass on the operator box.

# --- host identity (must differ per CP host) ---
# contabo-a (primary UI .163): CP_HOST_ID=contabo-a-163
# contabo-b (second node .141): CP_HOST_ID=contabo-b-141
CP_HOST_ID=contabo-a-163

# --- control-plane source paths (defaults work on stock Coolify installs) ---
CP_DB_CONTAINER=coolify-db
CP_DB_USER=coolify
CP_DB_NAME=coolify
COOLIFY_ENV_SRC=/data/coolify/source/.env
COOLIFY_ENV_PROD=/data/coolify/source/.env.production
SSH_KEYS_DIR=/data/coolify/ssh/keys
GPG_PASSPHRASE_FILE=/etc/coolify-cp-backup.pass

# --- local staging ---
DUMP_DIR=/var/backups/coolify-cp
LOCAL_KEEP_DAYS=7

# --- S3 destination (placeholders; real values only in /etc/coolify-cp-backup.env) ---
# Canonical object pattern written by the script:
#   s3://<S3_BUCKET>/coolify/control-plane/<host-id>/YYYY/MM/DD/coolify-db-<host-id>-<STAMP>.dump.gz
#   s3://<S3_BUCKET>/coolify/control-plane/<host-id>/YYYY/MM/DD/coolify-cp-bundle-<host-id>-<STAMP>.tar.gz.gpg
S3_BUCKET=dtc-coolify-backups-387546586013
S3_PREFIX=coolify/control-plane
S3_ENDPOINT_URL=https://s3.eu-west-1.amazonaws.com

# IAM user (MAIN): coolify-s3-backup-writer — keys only in ~/tmp/secrets/coolify-s3-backup-writer-*.env + Drive doc
# Object prefix scope: coolify/*  (see aws-infra main/coolify-backups)
AWS_ACCESS_KEY_ID=<S3_ACCESS_KEY>
AWS_SECRET_ACCESS_KEY=<S3_SECRET_KEY>
AWS_DEFAULT_REGION=eu-west-1
