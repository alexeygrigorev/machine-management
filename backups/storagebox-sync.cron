# Daily off-Contabo Storagebox mirror — S3 dumps/CP bundles + edge TLS + prune.
#
# Cadence: ONCE PER DAY at 04:30 Europe/Berlin (after the contabo 02:30 pg_dump
# and 03:30 control-plane cron runs, so fresh copies exist to mirror).
# TZ= pins the wall-clock time regardless of the host's system timezone.
#
# Install (idempotent) with:  sudo ./backups/install-storagebox-sync.sh
# which copies the scripts to /usr/local/sbin and this file to
# /etc/cron.d/storagebox-backup-sync on the Hetzner operator box.
#
# Manual run: sudo /usr/local/sbin/storagebox-backup-sync.sh
# (reads AWS creds via AWS_PROFILE=main-temp default; acme GPG passphrase
#  from ~/.secrets/acme-backup-gpg.pass of the cron user).

TZ=Europe/Berlin
30 4 * * * alexey /usr/local/sbin/storagebox-backup-sync.sh >> /var/log/storagebox-backup-sync.log 2>&1
