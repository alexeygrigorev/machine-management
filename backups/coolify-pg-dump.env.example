# Example env for backups/coolify-pg-dump.sh — COPY, fill in, NEVER commit.
#
#   sudo cp backups/coolify-pg-dump.env.example /etc/coolify-pg-dump.env
#   sudo chmod 600 /etc/coolify-pg-dump.env
#   sudo nano /etc/coolify-pg-dump.env   # real values only on the data node
#
# Secrets live in the private Drive doc "Contabo Coolify VPS — credentials
# 2026-10-22" and on operator hosts under ~/tmp/secrets/ (never in git).

# --- dumps: one line per stack ---
# pg-shared holds the CMP / AISHL / website databases (separate DB names, one instance).
PG_SHARED_CONTAINER=coolify-postgres-pg-shared-xxxx   # docker name on contabo-b; empty = use TCP below
PGUSER_SHARED=postgres
PG_SHARED_DBS="cmp aishl website"
# TCP fallback when PG_SHARED_CONTAINER is empty:
PGHOST_SHARED=127.0.0.1
PGPORT_SHARED=5433
# PGPASSWORD=<set in /etc/coolify-pg-dump.env on the node only>

# pg-relay is its OWN Postgres instance (never share with pg-shared).
PG_RELAY_CONTAINER=coolify-postgres-pg-relay-xxxx
PGUSER_RELAY=postgres
PG_RELAY_DB=relay
PGHOST_RELAY=127.0.0.1
PGPORT_RELAY=5434

# --- local staging ---
DUMP_DIR=/var/backups/coolify-postgres
LOCAL_KEEP_DAYS=7

# --- S3 destination (placeholders; real values only in /etc/coolify-pg-dump.env) ---
# Canonical object pattern written by the script:
#   s3://<S3_BUCKET>/<S3_PREFIX>/<pg-shared|pg-relay>/<dbname>/YYYY/MM/DD/<dbname>-<stack>-<STAMP>.dump.gz
S3_BUCKET=<BACKUP_BUCKET>
S3_PREFIX=coolify/postgres
S3_ENDPOINT_URL=<https://<s3-endpoint> or empty for AWS S3>
AWS_ACCESS_KEY_ID=<S3_ACCESS_KEY>
AWS_SECRET_ACCESS_KEY=<S3_SECRET_KEY>
AWS_DEFAULT_REGION=<s3-region>

# --- retention ---
# Primary S3 retention = bucket lifecycle rule (see s3-lifecycle.example.json).
# In-script prune is a backstop and defaults OFF.
S3_PRUNE_ENABLED=0
S3_RETENTION_DAYS=30
