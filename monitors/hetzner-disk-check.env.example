# Example env for monitors/hetzner-disk-check.sh — COPY, fill in, NEVER commit.
#
#   cp monitors/hetzner-disk-check.env.example ~/.hetzner-disk-check.env
#   chmod 600 ~/.hetzner-disk-check.env
#
# The defaults below are the production values (same standing recipients as
# coolify-healthcheck). Only override when drilling or testing.

# Space-separated real mounts to page on (sshfs storagebox is auto-detected
# and reported only, never paged; tmpfs/overlay/squashfs are excluded).
# DISK_MOUNTS="/ /boot /data"

# Thresholds: WARN when free below, CRIT when free below (percent of size).
# DISK_WARN_FREE_PCT=15
# DISK_CRIT_FREE_PCT=8
# INODE_WARN_FREE_PCT=10
# INODE_CRIT_FREE_PCT=5

# Fill trend: samples from the last FILL_WINDOW_H hours; CRIT when the disk
# fills within FILL_CRIT_H hours at the current linear rate.
# FILL_WINDOW_H=6
# FILL_CRIT_H=24

# --- alerting ---
# ALERT_TO=alexey@datatalks.club,dev@dtcdev.click
# ALERT_OPS_TO=dev@dtcdev.click
# ALERT_FROM=alerts@dtcdev.click
# ALERT_FROM_NAME=DTC Alerts
# ALERT_MSMTP_ACCOUNT=alerts
# While a check keeps failing, repeat the alert at most this often (minutes).
# ALERT_REPEAT_MIN=240
# Recovery notice is sent when a FAIL lasted at least this long (seconds).
# RECOVER_NOTIFY_MIN_SEC=600

# --- drill (safe, proves the mail path to ALERT_OPS_TO only) ---
# DISK_DRILL=1
