# Example env for monitors/relay-pg-dns-watchdog.sh — COPY, fill in, NEVER commit.
#   sudo cp monitors/relay-pg-dns-watchdog.env.example /etc/relay-pg-dns-watchdog.env
#   sudo chmod 600 /etc/relay-pg-dns-watchdog.env
#
# Runs on contabo-b (data node). Cadence: every 1 minute (see .cron).
# Detects Coolify PG IP/DNS churn that leaves Relay workers with stale resolve
# (t1205u/t1207u: mqimefrti7ratmaliirnikov 10.0.1.2→10.0.1.15).

PG_LABELS=pg-relay
# Also watch shared apps if desired:
# PG_LABELS="pg-relay pg-shared"

PGUSER=pgadmin
PG_DB=relay
# Per-label database mapping (required for pg-shared: it has no `relay` db).
# Without this, the pg-shared branch self-check STANDDOWNs every run.
# PG_DB_pg_shared=postgres

CONNECT_TIMEOUT=4
RESTART_VERIFY_WAIT=12
RESTART_COOLDOWN_SEC=900
# Skip dependent probes/restarts while Coolify attaches networks and starts workers.
DEP_STARTUP_GRACE_SEC=120
# Confirm an older container DNS miss with DNS+TCP again in this run (seconds).
DNS_RECHECK_WAIT_SEC=25
DRY_RUN=0
# DEPENDENT_EXCLUDE=^coolify-proxy$|^coolify-realtime$|^watchtower$

# Worker-progress checks beyond fresh sibling TCP (t1218u):
PROGRESS_CHECKS=1
PROGRESS_SQL_CHECKS=1
RESTART_WORKERS_OLDER_THAN_PG=1
PG_RECREATE_GRACE_SEC=15
SCHEDULER_MAX_AGE_SEC=180
TASK_QUEUE_MAX_READY_AGE_SEC=180
# Handled per-task DB error (deadlock / serialization failure) with no later
# successful work in a loop the SQL queue check does not cover: restart only
# after this many seconds without progress (hub intake 4140f58a).
HANDLED_DB_ERROR_GRACE_SEC=300

ALERT_TO=alexey@datatalks.club,dev@dtcdev.click
# Benign WARN (connection/DNS DB error that later recovered) goes only here.
# Deadlock / serialization / other DB-error WARNs and all FAILs use ALERT_TO.
ALERT_OPS_TO=dev@dtcdev.click
ALERT_FROM=alerts@dtcdev.click
ALERT_FROM_NAME="DTC Alerts"
ALERT_MSMTP_ACCOUNT=alerts
ALERT_REPEAT_MIN=60
# Outage / flap notification tuning (t1273u / t1342u):
# Suppress RECOVERED notice if outage lasted shorter than this many seconds (default 600s = 10m)
RECOVER_NOTIFY_MIN_SEC=600
# At most one AUTOHEALED notice per check per cooldown window (default 3600s = 1h)
AUTOHEALED_COOLDOWN_SEC=3600

STATE_DIR=/var/lib/relay-pg-dns-watchdog
LOCK_FILE=/var/lock/relay-pg-dns-watchdog.lock
LOG_FILE=/var/log/relay-pg-dns-watchdog.log
