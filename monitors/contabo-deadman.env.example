# Example env for monitors/contabo-deadman.sh — COPY, fill in, NEVER commit.
#
#   cp monitors/contabo-deadman.env.example ~/.contabo-deadman.env
#   chmod 600 ~/.contabo-deadman.env
#
# The script works without this file (compiled-in defaults below); create it
# only to override hosts, thresholds, probes, or recipients.

# SSH targets checked for reachability + on-node check freshness.
# DEADMAN_HOSTS="contabo-a contabo-b"
# Overall seconds for each SSH operation, including the remote command.
# DEADMAN_SSH_TIMEOUT=10
# Remote log; only terminal ALL_OK/CHECKS_FAILED timestamps prove freshness.
# DEADMAN_REMOTE_LOG=/var/log/coolify-healthcheck.log
# Stale if the latest completed run is older than this (5-min cadence + margin).
# DEADMAN_MAX_LOG_AGE_SEC=600

# External content probes from THIS box (name=url::marker; lowercase markers,
# no whitespace — same semantics as coolify-healthcheck.sh CONTENT_CHECKS).
# DEADMAN_URLS='courses_api=https://courses.datatalks.club/api/health/::"status":"ok" website_ready=https://prod.datatalks.club/health/ready::"status":"ready" relay_health=https://relay.datatalks.club/health/::"service":"relay"'

# --- alerting (Hetzner mail path; SMTP configured privately in ~/.msmtprc) ---
# ALERT_TO=alexey@datatalks.club,dev@dtcdev.click
# Drills (DEADMAN_FORCE_FAIL) only — never alexey@ (t1273u/t1274u):
# ALERT_OPS_TO=dev@dtcdev.click
# ALERT_FROM=alerts@dtcdev.click
# ALERT_FROM_NAME="DTC Alerts"
# ALERT_MSMTP_ACCOUNT=alerts
# ALERT_REPEAT_MIN=60

# --- paths (user-writable; no root needed) ---
# STATE_DIR=$HOME/.local/state/contabo-deadman
# LOCK_FILE=$HOME/.local/state/contabo-deadman.lock

# --- safe drill (mail-path proof, no production impact) ---
# Run once with DEADMAN_FORCE_FAIL=1 to get one FAIL mail, then normally
# again for the RECOVERED mail. Never set this in the env file or cron.
# DEADMAN_FORCE_FAIL=0

# --- latency probes (f5d8e22b AC2: off-Contabo TTFB/total into VM) ---
# LATENCY_PROBES="cmp_health=https://courses.datatalks.club/api/health/::cmp aisl_home=https://aishippinglabs.com/::aisl aisl_content=https://aishippinglabs.com/blog/what-does-an-ai-engineer-do::aisl relay_health=https://relay.datatalks.club/health/::relay website_home=https://datatalks.club/::website website_events_past=https://datatalks.club/events/past::website"
# LATENCY_PUSH_ENABLED=1
# Direct push first, else SSH to contabo-a (Hetzner has no WG route):
# LATENCY_PUSH_URL=http://10.100.0.1:8429/api/v1/import/prometheus
# LATENCY_PUSH_SSH_HOST=contabo-a
# LATENCY_TTFB_WARN_SEC=3
# LATENCY_TTFB_RECOVER_SEC=2.5
# LATENCY_SUSTAIN_SEC=600
# Slowness pages go ONLY here (never ALERT_TO):
# LATENCY_ALERT_TO=dev@dtcdev.click
