# Example env for monitors/coolify-proxy-networks.sh — COPY, fill in, NEVER commit.
#
#   sudo cp monitors/coolify-proxy-networks.env.example /etc/coolify-proxy-networks.env
#   sudo chmod 600 /etc/coolify-proxy-networks.env
#
# No secrets here: only container/network names (Coolify uuids) enter mail.
# This pager is dev@ ONLY by design (the main healthcheck may also page
# Alexey; a detached proxy is a self-healing routing fault, not a data fault).

# Proxy container name on this host (Coolify default).
PROXY_CONTAINER=coolify-proxy

# Alerting (dev@ ONLY — do NOT add Alexey here; same dedupe/recover rules as
# the main healthcheck: repeat at most every ALERT_REPEAT_MIN while failing).
ALERT_TO=dev@dtcdev.click
ALERT_FROM=alerts@dtcdev.click
ALERT_FROM_NAME="DTC Alerts"
ALERT_MSMTP_ACCOUNT=alerts
ALERT_REPEAT_MIN=60
# Match main healthcheck: suppress rapid RECOVERED mail, keep FAIL immediate.
RECOVER_NOTIFY_MIN_SEC=600

# --- paths ---
STATE_DIR=/var/lib/coolify-proxy-networks
LOCK_FILE=/var/lock/coolify-proxy-networks.lock
LOG_FILE=/var/log/coolify-healthcheck.log

# Isolated drills may override ALERT_SUBJECT_PREFIX to clearly mark test mail.
