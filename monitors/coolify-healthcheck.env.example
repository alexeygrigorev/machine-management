# Example env for monitors/coolify-healthcheck.sh — COPY, fill in, NEVER commit.
#
#   sudo cp monitors/coolify-healthcheck.env.example /etc/coolify-healthcheck.env
#   sudo chmod 600 /etc/coolify-healthcheck.env
#   sudo nano /etc/coolify-healthcheck.env   # real values only on the node(s)
#
# Secrets live in the private Drive doc "Contabo Coolify VPS — credentials
# 2026-10-22" and on operator hosts under ~/.secrets/ (never in git).

# --- Postgres: pg-shared (Coolify container on contabo-b preferred) ---
# Leave the container empty to auto-resolve via the Coolify label
# (coolify.resourceName=pg-shared); explicit names win when set.
# Coolify standalone-postgresql uses POSTGRES_USER=pgadmin — there is NO
# `postgres` role (using it fails with FATAL: role "postgres" does not exist).
PG_SHARED_CONTAINER=
PGUSER_SHARED=pgadmin   # Coolify standalone PG superuser
PG_SHARED_DB=postgres          # db used for SELECT 1 (any always-present db)
# TCP fallback when no container resolves (no docker / label miss):
PGHOST_SHARED=127.0.0.1
PGPORT_SHARED=5433
# PGPASSWORD_SHARED=<set here on the node only>

# --- Postgres: pg-relay (OWN instance, never shared with pg-shared) ---
# Same auto-discovery via label coolify.resourceName=pg-relay when empty.
PG_RELAY_CONTAINER=
PGUSER_RELAY=pgadmin
PG_RELAY_DB=relay
PGHOST_RELAY=127.0.0.1
PGPORT_RELAY=5434
# PGPASSWORD_RELAY=<set here on the node only>

# --- HTTP / app checks (space-separated name=url pairs, no spaces inside) ---
# Fill real public URLs once DNS points at Contabo Traefik. Coolify UI is the
# raw IP:port on the primary. Health endpoints preferred over "/" where apps
# expose them.
APP_URLS="coolify_ui=http://169.58.119.163:8000/ relay=https://relay.datatalks.club/health/ cmp=https://<cmp-host>/api/health/ aishl=https://<aishl-host>/ website=https://<website-host>/"
HTTP_TIMEOUT=15
# t1228u: connect includes DNS; retry transient curl-28 resolve timeouts
HTTP_CONNECT_TIMEOUT=10
HTTP_RETRIES=2
HTTP_RETRY_SLEEP_SEC=1

# --- content-marker checks (AC t1037u: NOT status-only) ---
# Space-separated name=url::marker triples. URL must return 2xx/3xx AND the
# body (lowercased, whitespace stripped) must contain the marker verbatim.
# Write markers LOWERCASE with NO whitespace; see script header for limits.
# Verified 2026-10-22 (DR P1 content uptime t1037u):
CONTENT_CHECKS='courses_api=https://courses.datatalks.club/api/health/::"status":"ok" aishl_home=https://aishippinglabs.com/::aishippinglabs website_home=https://datatalks.club/::welcometodatatalks.club website_ready=https://prod.datatalks.club/health/ready::"status":"ready" relay_health=https://relay.datatalks.club/health/::"service":"relay"'
# relay_dtcdev is RED as of 2026-10-22 (host dark: all TCP filtered from 3
# vantage points) — it pages dev@ until the relay owner restores it. To mute
# ONLY that entry, delete the relay_dtcdev=... triple from the line above
# (do NOT blank the whole var — the other six entries are green).

# --- AISHL django_q failure/progress (t1143u; ONLY on the PG data host) ---
# Recurring task failures page until the app-side SQL fix lands (sibling
# AISHL worker owns the fix; this flag only watches). Needs the local
# pg-shared container (label auto-discovery); enabling elsewhere FAILs loud.
# CHECK_AISL_Q=1
# AISL_Q_FAIL_MAX_24H=10
# AISL_Q_PROGRESS_MAX_AGE_SEC=3600

# --- residual Created-container detection (t1143u; every node with docker) ---
# FAILs on Created containers older than the grace (fresh deploys pass
# through Created briefly). Removal stays manual after inspection.
# CREATED_GRACE_SEC=1800

# --- alerting ---
ALERT_TO=alexey@datatalks.club,dev@dtcdev.click
ALERT_FROM=alerts@dtcdev.click
ALERT_FROM_NAME="DTC Alerts"
ALERT_MSMTP_ACCOUNT=alerts
# While a check keeps failing, repeat the alert at most this often (minutes).
ALERT_REPEAT_MIN=60
# Suppress RECOVERED mail when FAIL lasted shorter than this (seconds).
# FAIL still pages immediately. Default 600 cuts rapid FAIL→RECOVERED pairs
# (t1273u). Do NOT use FAIL streak to hide AISHL Coolify-replace 503s — fix
# zero-downtime instead (t1274u).
# RECOVER_NOTIFY_MIN_SEC=600
# On contabo-a only: skip public hostname HTTP/content checks so contabo-b
# is the sole public pager (dedupe dual-host duplicate mails).
# SKIP_PUBLIC_HTTP_CHECKS=1
# On contabo-b: leave SKIP_PUBLIC_HTTP_CHECKS unset or set it to 0.
# AISHL HTTP/content FAILs must still page; see the zero-downtime intake
# linked in monitors/README.md.

# --- paths ---
STATE_DIR=/var/lib/coolify-healthcheck
LOCK_FILE=/var/lock/coolify-healthcheck.lock
LOG_FILE=/var/log/coolify-healthcheck.log

# --- optional skips (contabo-a: PG is docker-only on contabo-b) ---
# SKIP_PG_SHARED=1
# SKIP_PG_RELAY=1

# --- backup freshness / disk ---
# contabo-b (data): SKIP_BACKUP_CHECKS=0 — missing dumps/WAL must alert.
# When unset, checks run only on hostname vmd210005 or contabo-b.
# BACKUP_HOSTNAME=vmd210005  # override after a data-host rename
# Operator hosts (RMTHZ) skip local backups; explicit =0 enables drills.
# contabo-a (CP): MUST set SKIP_BACKUP_CHECKS=1 (t1209u: otherwise dump-*/wal-*
# false-FAIL every 5m; artifacts only on .141).
# SKIP_BACKUP_CHECKS=1
# SKIP_DISK_CHECK=0
DUMP_DIR=/var/backups/coolify-postgres
EXPECT_DBS="cmp aisl website relay"
DUMP_STALE_SECONDS=129600
WAL_SHIPPER_STATE_DIR=/var/lib/coolify-wal-shipper
WAL_STACKS="pg-shared pg-relay"
WAL_STALE_SECONDS=1200
# Idle-tolerant WAL freshness (a3348a3e/t1862u, 2026-10-28): before paging a
# stale last-success, the healthcheck verifies pg_stat_archiver + the PGDATA
# spool — an idle DB (current WAL within one segment of last archived,
# failed_count flat, spool empty) is NOT a FAIL; backlog/failed_count increase/
# non-empty spool/unverifiable still page within ~20 min. 0 = old age-only page.
# WAL_IDLE_VERIFY=1
# One bounded re-read when the shipper state file is read empty/garbled
# (publish is truncate+write; 91e25fd made it atomic too):
# WAL_IDLE_REREAD_WAIT_SEC=0.5
DISK_WARN_PERCENT=85

# Enable on the Relay database host (contabo-b). Alert if any callback has
# been pending >30 minutes, or any currently failed row was attempted in 24h.
# Uses PG_RELAY_* settings above; no payloads or credentials enter alert mail.
CHECK_CMP_CALLBACKS=0

# --- latency probes (f5d8e22b AC2+AC3: TTFB/total into VM, slowness pages) ---
# CMP probe is the cheap /api/health/ endpoint only — never a page render
# (6e626719). AISHL home + content, Relay /health, website home + /events/past.
# LATENCY_PROBES="cmp_health=https://courses.datatalks.club/api/health/::cmp aisl_home=https://aishippinglabs.com/::aisl aisl_content=https://aishippinglabs.com/blog/what-does-an-ai-engineer-do::aisl relay_health=https://relay.datatalks.club/health/::relay website_home=https://datatalks.club/::website website_events_past=https://datatalks.club/events/past::website"
# LATENCY_PUSH_ENABLED=1
# VM over WireGuard from Contabo hosts:
# LATENCY_PUSH_URL=http://10.100.0.1:8429/api/v1/import/prometheus
# LATENCY_PUSH_TIMEOUT=10
# Slowness: TTFB > 3s for >=600s -> mail ONLY LATENCY_ALERT_TO (dev@), hysteresis recover <2.5s.
# LATENCY_TTFB_WARN_SEC=3
# LATENCY_TTFB_RECOVER_SEC=2.5
# LATENCY_SUSTAIN_SEC=600
# LATENCY_ALERT_TO=dev@dtcdev.click
# On contabo-a (metrics only, contabo-b owns public slowness pages):
# LATENCY_ALERT_ONLY_METRICS=1
