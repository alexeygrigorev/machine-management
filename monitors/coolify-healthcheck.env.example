# Example env for monitors/coolify-healthcheck.sh — COPY, fill in, NEVER commit.
#
#   sudo cp monitors/coolify-healthcheck.env.example /etc/coolify-healthcheck.env
#   sudo chmod 600 /etc/coolify-healthcheck.env
#   sudo nano /etc/coolify-healthcheck.env   # real values only on the node(s)
#
# Secrets live in the private Drive doc "Contabo Coolify VPS — credentials
# 2026-10-22" and on operator hosts under ~/.secrets/ (never in git).

# --- Postgres: pg-shared (Coolify container on contabo-b preferred) ---
# Leave the container empty to auto-resolve via the Coolify label
# (coolify.resourceName=pg-shared); explicit names win when set.
# Coolify standalone-postgresql uses POSTGRES_USER=pgadmin — there is NO
# `postgres` role (using it fails with FATAL: role "postgres" does not exist).
PG_SHARED_CONTAINER=
PGUSER_SHARED=pgadmin   # Coolify standalone PG superuser
PG_SHARED_DB=postgres          # db used for SELECT 1 (any always-present db)
# TCP fallback when no container resolves (no docker / label miss):
PGHOST_SHARED=127.0.0.1
PGPORT_SHARED=5433
# PGPASSWORD_SHARED=<set here on the node only>

# --- Postgres: pg-relay (OWN instance, never shared with pg-shared) ---
# Same auto-discovery via label coolify.resourceName=pg-relay when empty.
PG_RELAY_CONTAINER=
PGUSER_RELAY=pgadmin
PG_RELAY_DB=relay
PGHOST_RELAY=127.0.0.1
PGPORT_RELAY=5434
# PGPASSWORD_RELAY=<set here on the node only>

# --- HTTP / app checks (space-separated name=url pairs, no spaces inside) ---
# Fill real public URLs once DNS points at Contabo Traefik. Coolify UI is the
# raw IP:port on the primary. Health endpoints preferred over "/" where apps
# expose them.
APP_URLS="coolify_ui=http://169.58.119.163:8000/ relay=https://<relay-host>/healthz cmp=https://<cmp-host>/ aishl=https://<aishl-host>/ website=https://<website-host>/"
HTTP_TIMEOUT=15

# --- content-marker checks (AC t1037u: NOT status-only) ---
# Space-separated name=url::marker triples. URL must return 2xx/3xx AND the
# body (lowercased, whitespace stripped) must contain the marker verbatim.
# Write markers LOWERCASE with NO whitespace; see script header for limits.
# Verified 2026-10-22 (DR P1 content uptime t1037u):
CONTENT_CHECKS='courses_api=https://courses.datatalks.club/api/health/::"status":"ok" courses_home=https://courses.datatalks.club/::activecourses aishl_home=https://aishippinglabs.com/::aishippinglabs website_home=https://datatalks.club/::welcometodatatalks.club website_ready=https://prod.datatalks.club/health/ready::"status":"ready" relay_health=https://relay.datatalks.club/health/::"service":"relay"'
# relay_dtcdev is RED as of 2026-10-22 (host dark: all TCP filtered from 3
# vantage points) — it pages dev@ until the relay owner restores it. To mute
# ONLY that entry, delete the relay_dtcdev=... triple from the line above
# (do NOT blank the whole var — the other six entries are green).

# --- alerting ---
ALERT_TO=alexey@datatalks.club,dev@dtcdev.click
ALERT_FROM=noreply@datatalks.club
# While a check keeps failing, repeat the alert at most this often (minutes).
# Recovery notice is always sent on transition back to OK.
ALERT_REPEAT_MIN=60

# --- paths ---
STATE_DIR=/var/lib/coolify-healthcheck
LOCK_FILE=/var/lock/coolify-healthcheck.lock
LOG_FILE=/var/log/coolify-healthcheck.log

# --- optional skips (contabo-a: PG is docker-only on contabo-b) ---
# SKIP_PG_SHARED=1
# SKIP_PG_RELAY=1

# --- backup freshness / disk ---
# contabo-b (data): leave SKIP_BACKUP_CHECKS unset/0 — dumps+WAL live here.
# contabo-a (CP): MUST set SKIP_BACKUP_CHECKS=1 (t1209u: otherwise dump-*/wal-*
# false-FAIL every 5m; artifacts only on .141).
# SKIP_BACKUP_CHECKS=1
# SKIP_DISK_CHECK=0
DUMP_DIR=/var/backups/coolify-postgres
EXPECT_DBS="cmp aisl website relay"
DUMP_STALE_SECONDS=129600
WAL_SHIPPER_STATE_DIR=/var/lib/coolify-wal-shipper
WAL_STACKS="pg-shared pg-relay"
WAL_STALE_SECONDS=1200
DISK_WARN_PERCENT=85
